---
interface Props {
  lat: number;
  lng: number;
  title?: string;
}

const { lat, lng, title = 'La Parada del Arriero' } = Astro.props;
const mapUrl = `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3000!2d${lng}!3d${lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2z${lat}%2C${lng}!5e0!3m2!1ses!2ses!4v1`;
const staticMapUrl = `https://maps.google.com/maps?q=${lat},${lng}&t=&z=13&ie=UTF8&iwloc=&output=embed`;
---

<div class="w-full h-80 md:h-96 rounded-lg overflow-hidden border border-[var(--color-border)]">
  <iframe
    src={staticMapUrl}
    width="100%"
    height="100%"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={title}
  />
</div>
