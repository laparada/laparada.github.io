---
import { useTranslations, getNavLinks } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  currentPage?: string;
}

const { lang, currentPage = '' } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: `/${lang}/`, label: 'Inicio', key: 'index' },
  { href: `/${lang}/el-restaurante/`, label: t('nav.restaurante'), key: 'el-restaurante' },
  { href: `/${lang}/carta/`, label: t('nav.carta'), key: 'carta' },
  { href: `/${lang}/galeria/`, label: t('nav.galeria'), key: 'galeria' },
  { href: `/${lang}/nuestro-entorno/`, label: t('nav.entorno'), key: 'nuestro-entorno' },
  { href: `/${lang}/contacto/`, label: t('nav.contacto'), key: 'contacto' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-sm border-b border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex items-center gap-3 shrink-0">
        <img src="/images/logo.png" alt="La Parada del Arriero" class="h-10 w-auto" />
        <span class="hidden sm:block font-[var(--font-display)] text-[var(--color-accent)] text-lg">
          La Parada del Arriero
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded text-sm transition-colors',
              currentPage === link.key
                ? 'text-[var(--color-accent)] bg-white/10'
                : 'text-gray-300 hover:text-[var(--color-accent)] hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <LanguageSwitcher lang={lang} currentPage={currentPage} />
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-gray-300 hover:text-[var(--color-accent)]"
          aria-label="Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-black/95 border-t border-[var(--color-border)]">
    <div class="px-4 py-3 space-y-1">
      {links.map(link => (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-3 rounded text-base transition-colors',
            currentPage === link.key
              ? 'text-[var(--color-accent)] bg-white/10'
              : 'text-gray-300 hover:text-[var(--color-accent)] hover:bg-white/5',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
