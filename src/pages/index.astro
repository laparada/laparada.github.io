---
// Language detection redirect
---
<html>
  <head>
    <meta charset="utf-8" />
    <title>La Parada del Arriero</title>
    <script is:inline>
      const lang = navigator.language || navigator.userLanguage || 'es';
      const prefix = lang.startsWith('de') ? 'de' : lang.startsWith('en') ? 'en' : 'es';
      window.location.replace('/' + prefix + '/');
    </script>
    <meta http-equiv="refresh" content="0;url=/es/" />
  </head>
  <body></body>
</html>
