---
import PageLayout from '../../layouts/PageLayout.astro';
import GoogleMap from '../../components/GoogleMap.astro';
import { contacto } from '../../i18n/content/es/index';
---

<PageLayout title={contacto.title} description={contacto.metaDescription} lang="es" currentPage="contacto">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-[var(--color-bg-card)]/80 backdrop-blur-sm rounded-xl p-6 md:p-10 border border-[var(--color-border)]">
      <h1 class="text-3xl md:text-4xl font-[var(--font-display)] text-[var(--color-accent)] mb-8">{contacto.title}</h1>

      <h2 class="text-2xl font-[var(--font-display)] text-[var(--color-accent)] mb-4">{contacto.locationTitle}</h2>
      <div class="space-y-4 text-gray-300 leading-relaxed mb-8">
        <p set:html={contacto.locationText} />
        <p set:html={contacto.directions} />
      </div>

      <div class="bg-[var(--color-bg-dark)] rounded-lg p-6 border border-[var(--color-border)] mb-8">
        <h3 class="text-xl font-[var(--font-display)] text-[var(--color-accent)] mb-3">{contacto.phoneTitle}</h3>
        <ul class="space-y-2 text-gray-300">
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+34602294143" class="text-[var(--color-accent)] hover:underline font-semibold">{contacto.phone}</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${contacto.email}`} class="text-[var(--color-accent)] hover:underline">{contacto.email}</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{contacto.address}</span>
          </li>
        </ul>
      </div>

      <GoogleMap lat={contacto.mapLat} lng={contacto.mapLng} />
    </div>
  </div>
</PageLayout>
