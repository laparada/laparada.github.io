---
import PageLayout from '../../layouts/PageLayout.astro';
import MenuSection from '../../components/MenuSection.astro';
import { carta } from '../../i18n/content/es/index';
---

<PageLayout title={carta.title} description={carta.metaDescription} lang="es" currentPage="carta">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-[var(--color-bg-card)]/80 backdrop-blur-sm rounded-xl p-6 md:p-10 border border-[var(--color-border)]">
      <h1 class="text-3xl md:text-4xl font-[var(--font-display)] text-[var(--color-accent)] mb-8">{carta.title}</h1>
      <div class="space-y-4">
        {carta.sections.map((section, i) => (
          <MenuSection name={section.name} items={section.items} open={i === 0} />
        ))}
      </div>
    </div>
  </div>
</PageLayout>
